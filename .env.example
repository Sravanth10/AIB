# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Phase 2: executive narrative via Amazon Bedrock ------------------------
# Optional. Without these the narrative panel composes its summary from the same
# computed trend/risk/cluster figures using deterministic rules — the page works
# fully, it just does not call a model.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# Bedrock model id. Bedrock ids carry an "anthropic." prefix.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# --- Hosting ---------------------------------------------------------------
# Writable state (uploads, generated packs, cached narratives). Defaults to ./data.
# Point this at a mounted disk when deploying so state survives restarts.
# DATA_DIR=/var/data

# Set to 1 to deploy an empty instance instead of rebuilding the demo history
# on a cold start.
# SKIP_BOOTSTRAP_DEMO=1
