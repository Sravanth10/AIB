{
  "$comment": "Structural fingerprints for the 5 Phase 1 source types. Matching is CONTENT ONLY - filenames are never inspected, because the demo claim is that a file dropped in with any name is identified from its structure. Scoring weights live in server/classify.js.",
  "templates": [
    {
      "id": "bancs",
      "label": "BaNCS extract",
      "metricSource": "BaNCS",
      "blurb": "Policy admin / workflow transactional extract",
      "shapes": [
        "grid"
      ],
      "requiredHeaders": [
        "policy number",
        "process type",
        "tat"
      ],
      "signatureHeaders": [
        "received date",
        "completed date",
        "branch",
        "process sub type",
        "status"
      ],
      "vocabulary": [
        "policy administration",
        "completed stp",
        "rework required",
        "policy issuance",
        "medical uw",
        "endorsement",
        "wf extract"
      ],
      "negative": [
        "queue name",
        "subscription id",
        "original message",
        "days to resolve"
      ]
    },
    {
      "id": "awsConnect",
      "label": "AWS Connect report",
      "metricSource": "AWS Connect",
      "blurb": "Contact centre queue performance export",
      "shapes": [
        "grid"
      ],
      "requiredHeaders": [
        "queue name",
        "calls offered",
        "calls answered"
      ],
      "signatureHeaders": [
        "avg speed to answer",
        "abandonment rate",
        "avg handle time",
        "qa score",
        "calls abandoned"
      ],
      "vocabulary": [
        "amazon connect",
        "arn aws connect",
        "instance arn",
        "queue daily performance",
        "historical metrics",
        "policy servicing",
        "new business enquiries"
      ],
      "negative": [
        "policy number",
        "subscription id",
        "original message",
        "days to resolve"
      ]
    },
